# Live-browser service env — copy to `.env` (gitignored) / set in your secret store.
# This service streams a real Chromium (CDP screencast + input) to the annotator's
# live pane. It is a SEPARATE deployable from the gym server.

# ============================================================
# REQUIRED for a real deploy — both have INSECURE fallbacks if left unset
# ============================================================
# HMAC key that signs live-session tickets. MUST equal the annotator backend's
# LIVE_STREAM_SECRET. If unset it falls back to HARNESS_TOKEN, then to the
# hardcoded 'dev-live-secret' — a KNOWN key, so anyone could mint valid tickets.
# Always set this explicitly for a deploy.  Generate:  openssl rand -hex 32
LIVE_STREAM_SECRET=

# Comma-separated allow-list of the annotator FRONTEND origin(s), e.g.
#   https://annotator.delta.deccanexperts.ai
# Enforced for CORS and the websocket Origin handshake. The default '*' disables
# the check and allows ANY site — do not ship '*' to production.
LIVE_ALLOWED_ORIGINS=

# ============================================================
# OPTIONAL (safe defaults)
# ============================================================
PORT=8877
# LIVE_TICKET_TTL_S=300     # session ticket lifetime (seconds)
# LIVE_VIEWPORT_W=1280
# LIVE_VIEWPORT_H=800
