# Gym runtime env — copy to `.env` (gitignored) and fill in.
# `.env` is read fresh on every agent run by server/main.py::_spawn_eval_run and
# OVERRIDES the process env. For a real deploy, set these in your secret store
# (e.g. AWS Secrets Manager) rather than a committed file.

# ============================================================
# REQUIRED
# ============================================================
# Bearer token gating every /_harness/* route (the annotator's control plane:
# run_agent, resume_run, screenshot, milestones). MUST equal the annotator
# backend's GYM_HARNESS_TOKEN. If unset the server still boots, but every
# /_harness/* call returns 503 and the annotator goes dead with no obvious cause.
# Generate once:  openssl rand -hex 32
HARNESS_TOKEN=

# ============================================================
# RUNTIME / DEPLOY (safe defaults — override per platform)
# ============================================================
# Port uvicorn binds. Injected by most platforms (Cloud Run / ECS). The eval.run
# subprocess dials http://localhost:$PORT, so this is the single source of truth.
PORT=8000
# 1/true/on/yes → serve the baked seed.db baseline on reset (the Docker image
# sets this). Falsy → rebuild worlds from the Python factories. Leave as-is.
SEEDDB_MODE=1

# ============================================================
# LLM AGENT KEYS
# Only needed to DRIVE an LLM agent (agent=llm/openai/pixel/…). agent=oracle is
# keyless. Missing keys fail per-run at runtime, not at boot.
# ============================================================
# Anthropic — agent=llm / pixel / pixel_coord
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenAI / OpenRouter — agent=openai / openai_pixel / openai_coord
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1   # only if routing via OpenRouter

# --- Debugging ---
# GYM_HEADED=1   # show a real Chromium window during a local agent run

# --- Advanced agent knobs (optional; sensible defaults live in code) ---
# AGENT_MAX_STEPS=50   AGENT_EVAL_MODE=0   LLM_CONTEXT_BUDGET=190000
# LLM_RESP_MAX_OUTPUT=8192   LLM_MAX_ATTEMPTS=3   LLM_CALL_TIMEOUT=120
# AGENT_COST_CAP_USD=0   AGENT_COST_TRIP_FRAC=0.8
