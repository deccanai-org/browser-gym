# Phase-5: auto-generated cascade run-reports (archived to docs/history/archive/cascade_reports.tgz; regenerable)
trajectories/cascade_*/**/*.md
trajectories/cascade_*/*.md

# Generated seed database (reproducible: python -m server.seeddb.build_seed_db)
fixtures/seed.db*.sqlite
fixtures/seed.db*.sqlite.tmp

# Pilot session registry (runtime state)
tools/.pilot_sessions.sqlite

# Vendored realistic mock UIs (websites/). Build artifacts are regenerated by
# tools/build_hub_mocks.sh from tools/product_assets — do not commit them.
node_modules/
websites/*/node_modules/
websites/*/dist/
websites/*/.mock-state*
websites/*/public/assets/

# Regenerable QA pipeline run outputs
tools/qa_pipeline/reports/
